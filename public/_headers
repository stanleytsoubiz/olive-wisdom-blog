/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-XSS-Protection: 1; mode=block
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  # Content-Security-Policy — added 2026-11-22 (Batch 3).
  # 'unsafe-inline' is required for scripts and styles: Next.js static
  # export injects inline scripts, and styled-jsx / inline style props
  # need inline styles. The policy still blocks everything else that
  # matters here: no plugins/embeds, no foreign frames, no foreign form
  # targets, and scripts/styles/images/fonts/connections only from the
  # sources the site actually uses (self, GA, Supabase, image CDNs).
  # If Turnstile is added later, add https://challenges.cloudflare.com
  # to script-src and frame-src.
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com https://www.google-analytics.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data:; connect-src 'self' https://*.supabase.co https://www.google-analytics.com https://region1.google-analytics.com https://*.google-analytics.com https://www.googletagmanager.com; frame-src 'none'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests

# ── 文章封面圖（24h 可更新）── 必須放在廣泛的 /*.jpg 規則之前：
# Cloudflare Pages 以先比對到的規則優先，之前這條寫在後面，封面
# 實際可能被快取 1 年，換圖不會生效 ──────────────────────────
/images/covers/*
  Cache-Control: public, max-age=86400, must-revalidate

# ── JS/CSS/靜態資源（hash 名稱 = immutable）────────────────────
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable
  Vary: Accept-Encoding

/assets/*
  Cache-Control: public, max-age=31536000, immutable
  Vary: Accept-Encoding

# ── 其他圖片快取 1 年 ──────────────────────────────────────────
# 注意：這裡刻意沒有全域的 /*.jpg / *.webp 規則。Workers 下
# _headers 的多條規則會同時生效（不像 Pages 是先比對到的贏），
# 全域規則會跟上面的 /images/covers/* 24 小時規則疊成雙值
# Cache-Control（兩個 max-age 並存，語義不明，2026-11-22 評估實測）。
# 站上唯一的非封面 jpg/webp 是首頁 hero 圖，單獨列在下面；封面
# 圖（jpg＋build 產生的 webp）只吃 /images/covers/* 的 24 小時規則。
# 新增非封面圖片時，在此補一條明確路徑，不要加回全域規則。
/hero-grove.webp
  Cache-Control: public, max-age=31536000, immutable

/*.png
  Cache-Control: public, max-age=31536000, immutable

/*.ico
  Cache-Control: public, max-age=31536000, immutable

# ── 字型快取 1 年 ──────────────────────────────────────────────
/*.woff2
  Cache-Control: public, max-age=31536000, immutable

# ── 資料 JSON：短快取（5 分鐘內生效）──────────────────────────
/data/*.json
  Cache-Control: public, max-age=300, must-revalidate
  Vary: Accept-Encoding

# ── HTML + 入口：永不快取 ──────────────────────────────────────
/*.html
  Cache-Control: no-cache, no-store, must-revalidate

/
  Cache-Control: no-cache, no-store, must-revalidate
  Link: </hero-grove.webp>; rel=preload; as=image; type="image/webp"
